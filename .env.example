# Database
DATABASE_URL="postgresql://user:password@localhost:5432/roofalert"

# Xweather API
XWEATHER_API_KEY="your-xweather-api-key"
XWEATHER_BASE_URL="https://api.xweather.com"

# Twilio (SMS)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# SendGrid (Email)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="alerts@tempestiq.com"

# Redis (Queue)
REDIS_URL="redis://localhost:6379"

# Next.js / Auth
NEXTAUTH_SECRET="your-secret-key"
# Base URL of the app (local: use your dev port; production: https://tempestiq.com)
NEXTAUTH_URL="http://localhost:3005"

# Stripe (subscriptions / credit card)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."   # Monthly price ID for Starter $79
STRIPE_PRICE_PROFESSIONAL="price_..." # Monthly price ID for Professional $199
STRIPE_PRICE_BUSINESS="price_..."  # Monthly price ID for Business $399

# App URL (checkout success/cancel redirects; same as NEXTAUTH_URL)
# Local: http://localhost:3005  |  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NODE_ENV="development"
