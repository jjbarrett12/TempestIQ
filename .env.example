# Database
DATABASE_URL="postgresql://user:password@localhost:5432/roofalert"

# Xweather API
XWEATHER_API_KEY="your-xweather-api-key"
XWEATHER_BASE_URL="https://api.xweather.com"

# Twilio (SMS)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# SendGrid (Email)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="alerts@tempestiq.com"

# Redis (Queue)
REDIS_URL="redis://localhost:6379"

# Next.js / Auth
NEXTAUTH_SECRET="your-secret-key"
# One-time setup: create admin user at /setup-admin (set a secret, then remove after use)
CREATE_ADMIN_SECRET="your-one-time-secret"
# Base URL of the app (local: use your dev port; production: https://tempestiq.com)
NEXTAUTH_URL="http://localhost:3005"

# Stripe (subscriptions / credit card)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."   # Monthly price ID for Starter $79
STRIPE_PRICE_PROFESSIONAL="price_..." # Monthly price ID for Professional $199
STRIPE_PRICE_BUSINESS="price_..."  # Monthly price ID for Business $399

# App URL (checkout success/cancel redirects; same as NEXTAUTH_URL)
# Local: http://localhost:3005  |  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NEXT_PUBLIC_SITE_URL="https://tempestiq.com"

# Push notifications (Firebase + Supabase)
# Firebase - client (from Firebase Console > Project settings > General)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# VAPID key from Firebase Console > Project settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Firebase Admin (from Service account JSON)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Supabase (for push tables - device_tokens, alert_events, etc.)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Cron secret (generate random string; Vercel cron sends header x-cron-secret)
CRON_SECRET=""

NODE_ENV="development"
